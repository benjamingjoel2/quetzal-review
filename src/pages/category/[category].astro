---
import ListingPage from '../../components/ListingPage.astro';
import { CATEGORIES, CATEGORY_SLUGS, DESTINATIONS, type CategorySlug } from '../../data/taxonomy';
import { getPosts } from '../../lib/site';

export function getStaticPaths() {
  return CATEGORY_SLUGS.map((category) => ({ params: { category } }));
}
const category = Astro.params.category as CategorySlug;
const c = CATEGORIES[category];
const posts = (await getPosts()).filter((p) => p.data.categories.includes(category));
---
<ListingPage
  title={c.name}
  intro={c.intro}
  description={`${c.name}: ${c.intro}`}
  posts={posts}
  crumbs={[{ name: 'Home', path: '/' }, { name: c.name, path: `/category/${category}/` }]}
>
  {category === 'destinations' && (
    <nav class="dest-links" aria-label="Destinations">
      <h2>Places</h2>
      <ul>
        {Object.entries(DESTINATIONS).map(([slug, d]) => <li><a href={`/destinations/${slug}/`}>{d.name}</a></li>)}
      </ul>
    </nav>
  )}
</ListingPage>
<style>
  .dest-links h2 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
  .dest-links ul { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .dest-links a { display: inline-block; padding: 0.5rem 0.9rem; min-height: 44px; border: 1px solid var(--line); background: var(--paper); border-radius: 999px; text-decoration: none; font-weight: 500; }
  .dest-links a:hover { border-color: var(--green); text-decoration: underline; }
</style>
