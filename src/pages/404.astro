---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found." crumbs={[{ name: 'Home', path: '/' }, { name: 'Page not found', path: '/404/' }]} noindex>
  <div class="wrap page">
    <h1>Page not found</h1>
    <p class="page-intro">We could not find that page. It may have moved, or the link may be mistyped.</p>
    <p><a class="button" href="/">Go to the home page</a> <a class="button secondary" href="/posts/">See all stories</a></p>
  </div>
</Base>
